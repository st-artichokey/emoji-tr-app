{
  "name": "emoji-tr-app",
  "version": "1.0.0",
  "description": "An emoji-reactive message translator app",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "dev": "node --watch app.js",
    "lint": "npx @biomejs/biome check *.js listeners",
    "lint:fix": "npx @biomejs/biome check --write *.js listeners",
    "start": "node app.js",
    "test": "node --test 'tests/**/*.spec.js' 'tests/*.spec.js'"
  },
  "author": "Rosanne Ussery",
  "license": "MIT",
  "keywords": [
    "slack",
    "bolt",
    "slackapi",
    "deepl"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/st-artichokey/emoji-tr-app"
  },
  "bugs": {
    "url": "https://github.com/st-artichokey/emoji-tr-app/issues"
  },
  "dependencies": {
    "@slack/bolt": "^4.6.0",
    "deepl-node": "^1.24.0",
    "dotenv": "~17.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@slack/cli-hooks": "^1.3.1",
    "esmock": "^2.7.3"
  }
}
